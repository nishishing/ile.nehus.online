---
import { navPrimary } from "~data/site";
import BrandMark from "~components/BrandMark.astro";
// 予約ボタンの文言。日本語のページは「予約」、英語のページは BOOK のまま
// （2026-11-22 オーナー「このブックじゃなくて予約っていう名前に変えましょう！でもっとわかりやすく大きく作ってもいいと思ってます！」）
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const bookLabel = isEn ? "BOOK" : "予約";
---

<header class="header">
  <a class="header__logo" href="/" aria-label="iLe — home">
    <BrandMark size={46} />
  </a>
  <nav class="header__nav" aria-label="Primary">
    <ul>
      {navPrimary.map((item) => (
        <li><a href={item.href} set:html={item.label} /></li>
      ))}
    </ul>
  </nav>
  <div class="header__right">
    <a href="/salons" class="header__action">{bookLabel}</a>
    <button
      type="button"
      class="header__menu-btn"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <span class="header__menu-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- Mobile full-screen menu (opened by the hamburger; ≤768px only) -->
<div id="mobile-menu" class="mobile-menu" hidden>
  <button type="button" class="mobile-menu__close" data-menu-close>
    Close ×
  </button>
  <nav class="mobile-menu__nav" aria-label="Mobile">
    <ul>
      {navPrimary.map((item) => (
        <li><a href={item.href} set:html={item.label} /></li>
      ))}
      <li class="mobile-menu__book"><a href="/salons">{bookLabel} →</a></li>
    </ul>
  </nav>
  <p class="mobile-menu__foot"><em>est.</em> 2020 — Harajuku, Tokyo</p>
</div>

<script>
  // 下へ読み進めたら、ヘッダーに暗い帯を敷く。ヘッダーの文字（SALONS など・JP/EN）は白なので、
  // 明るい背景や写真の上では読めなかった（2026-11-22 オーナー「直す」）。一番上（暗い見出しの上）では帯を出さない。
  const header = document.querySelector(".header");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const openBtn = document.querySelector("[data-menu-open]");
  const closeBtn = document.querySelector("[data-menu-close]");
  const menu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.toggleAttribute("hidden", !open);
    openBtn.setAttribute("aria-expanded", String(open));
    openBtn.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    document.documentElement.style.overflow = open ? "hidden" : "";
  };

  openBtn?.addEventListener("click", () => {
    setOpen(menu?.hasAttribute("hidden") ?? false);
  });
  closeBtn?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setOpen(false));
  });
</script>

<style>
  .header {
    position: fixed;
    top: var(--announce-h);
    left: 0;
    right: 0;
    z-index: 50;
    padding: 24px 32px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 48px;
    color: var(--color-white);
    transition: background-color 0.25s, box-shadow 0.25s, padding 0.25s;
  }
  .header.is-scrolled {
    background: rgba(22, 23, 26, 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px -16px rgba(0, 0, 0, 0.6);
  }
  /* 帯が出ている間は、ロゴとメニューの四角い地は要らない（帯と同じ色なので外す） */
  .header.is-scrolled .header__logo,
  .header.is-scrolled .header__menu-btn {
    background: transparent;
    box-shadow: none;
  }
  /* ロゴは白い線なので、明るい背景の上までスクロールすると薄くなって消えていた。
     メニューボタンと同じ暗い地を敷いて、どの背景でも見えるようにする（2026-11-22 オーナー「直す」）。 */
  .header__logo {
    display: inline-flex;
    line-height: 0;
    padding: 5px;
    background: rgba(22, 23, 26, 0.88);
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.45);
  }
  .header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 32px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .header__nav a {
    transition: opacity 0.15s;
  }
  .header__nav a:hover {
    opacity: 0.7;
  }
  .header__right {
    display: flex;
    gap: 22px;
    align-items: center;
    padding-right: 80px; /* space for language strip */
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  /* 予約ボタン: 白地に黒字の目立つボタン。ヘッダーの文字は白なので、明るい背景の上でも
     見えるように地を白で塗り、影をつける。 */
  .header__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 96px;
    padding: 11px 22px;
    background: var(--color-white);
    color: var(--color-ink);
    font-family: var(--font-body, inherit);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    line-height: 1;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.45);
    transition: opacity 0.15s, transform 0.15s;
  }
  .header__action:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  .header__menu-btn {
    display: none;
    background: none;
    border: 0;
    padding: 10px 2px;
    color: inherit;
    cursor: pointer;
  }
  .header__menu-icon {
    display: block;
    width: 22px;
    height: 9px;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }

  /* Mobile full-screen menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100; /* above Floating (80) and AnnounceBar (70) */
    background: var(--color-ink);
    color: var(--color-white);
    padding: 84px 28px 40px;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__close {
    position: absolute;
    top: 22px;
    right: 20px;
    background: none;
    border: 0;
    padding: 10px;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .mobile-menu__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .mobile-menu__nav a {
    font-family: var(--font-display);
    font-size: clamp(26px, 7.5vw, 38px);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: opacity 0.15s;
  }
  .mobile-menu__nav a:hover {
    opacity: 0.7;
  }
  .mobile-menu__book {
    margin-top: 14px;
  }
  .mobile-menu__book a {
    font-family: var(--font-body, inherit);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.2em;
    background: var(--color-white);
    color: var(--color-ink);
    padding: 16px 32px;
    display: inline-block;
  }
  .mobile-menu__foot {
    margin: auto 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    color: var(--color-fg-on-dark-muted);
  }

  @media (max-width: 768px) {
    .header {
      gap: 16px;
      padding: 18px 20px;
    }
    /* 携帯だけ、下げている間は帯を細くする（パソコンは右上の JP/EN と重なるので詰めない） */
    .header.is-scrolled {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .header__nav {
      display: none;
    }
    /* With the nav hidden, the grid collapses to two tracks — pin the
       actions to the right edge (the language strip is hidden on mobile). */
    .header__right {
      padding-right: 0;
      justify-self: end;
    }
    /* メニューの線は白なので、明るい背景の上で消えていた。暗い四角の地を敷いて、
       どの背景でも見えるようにする（2026-11-22 オーナー「直す」）。
       高さは隣の「予約」ボタン（34px）にそろえる。 */
    .header__menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      padding: 0;
      background: rgba(22, 23, 26, 0.88);
      color: var(--color-white);
      box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.45);
    }
    .header__menu-icon {
      width: 16px;
      height: 8px;
    }
    .header__action {
      min-width: 80px;
      padding: 10px 18px;
      font-size: 14px;
    }
  }
  /* Menu is mobile-only; never show on desktop even if state leaks. */
  @media (min-width: 769px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>
