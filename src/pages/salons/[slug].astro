---
import BaseLayout from "~layouts/BaseLayout.astro";
import { brandLabel } from "~lib/brand";
import PageHero from "~components/PageHero.astro";
import { getSalons, getStylists } from "~lib/content";
import StylistCard from "~components/StylistCard.astro";
import Picture from "~components/Picture.astro";
import {
  localBusinessSchema,
  breadcrumbSchema,
  faqPageSchema,
  jsonLd,
} from "~lib/schema";

export async function getStaticPaths() {
  const salons = await getSalons();
  return salons.map((salon) => ({
    params: { slug: salon.slug },
    props: { salon },
  }));
}

const { salon } = Astro.props;
const stylists = await getStylists();
const salonStylists = stylists.filter((s) => s.salonSlug === salon.slug);

const pageSchemas = [
  localBusinessSchema(salon),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Salons", url: "/salons" },
    { name: salon.nameLatin, url: `/salons/${salon.slug}` },
  ]),
];

// 題名に街の名前を日本語で入れる（2026-10-14・検索語「原宿 美容室」等に合わせる）
const AREA_JA: Record<string, string> = {
  "harajuku-a": "原宿",
  "harajuku-b": "原宿・表参道",
  nagoya: "名古屋・栄",
  nagaoka: "新潟・長岡",
};

// 地域向けの案内とよくある質問（2026-10-19 オーナー選択「店舗ページを地域向けに厚くする」）。
// 🔴 中身は salons.ts / stylists.ts の事実と、全店共通の確定事項だけで組み立てる。
//    店ごとの得意メニュー・受賞の店舗別の割り当て・英語対応など、確かめていないことは書かない。
const area = AREA_JA[salon.slug] ?? salon.cityShort;
const staffCount = salonStylists.length;
const salonFaq = [
  {
    question: `${salon.name}でエフェクトブリーチは受けられますか？`,
    answer:
      "はい。エフェクトブリーチは原宿・名古屋・長岡の全 iLe 店舗で対応しています。髪の状態やこれまでの履歴によって、できる明るさやプランが変わるため、施術前のカウンセリングでご相談ください。",
  },
  {
    question: `${salon.name}への行き方を教えてください。`,
    answer: `${salon.address}${salon.access ? `。${salon.access}` : ""}。`,
  },
  {
    question: "営業時間と定休日は？",
    answer: `営業時間は ${salon.hours.replace(/\s*—\s*/, "〜")} です。${salon.holidays ? `定休日は${salon.holidays === "年中無休" ? "なく、年中無休で営業しています" : salon.holidays}。` : ""}`,
  },
  {
    question: "予約はどうすればいいですか？",
    answer: `HOT PEPPER Beauty の${salon.name}のページからご予約いただけます。${salon.phone ? `店舗の電話番号は ${salon.phone} です。` : ""}`,
  },
  {
    question: "料金の目安はどこで見られますか？",
    answer:
      "メニューと料金の目安は、このサイトの「メニュー・料金」ページに載せています。最新の価格・所要時間・クーポンは、HOT PEPPER Beauty の各店ページでご確認ください。",
  },
  {
    question: "口コミは見られますか？",
    answer: `${salon.name}の口コミは、HOT PEPPER Beauty の口コミページでご覧いただけます。`,
  },
];
// 答えのあとに出すリンク（同じ順番）
const salonFaqLinks: (null | { href: string; label: string; external?: boolean })[] = [
  { href: "/effect-bleach", label: "エフェクトブリーチについて" },
  null,
  null,
  salon.hotPepperUrl ? { href: salon.hotPepperUrl, label: "HOT PEPPER Beauty で予約する", external: true } : null,
  { href: "/menu", label: "メニュー・料金" },
  salon.hotPepperUrl ? { href: `${salon.hotPepperUrl}review/`, label: "口コミを見る（HOT PEPPER Beauty）", external: true } : null,
];
const allSchemas = [...pageSchemas, faqPageSchema(salonFaq)];


---

<BaseLayout
  title={`${salon.name}｜${AREA_JA[salon.slug] ?? salon.cityShort}の美容室`}
  description={salon.seoDescription ?? salon.description}
>
  <Fragment slot="head">
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={jsonLd(schema)} is:inline />
    ))}
  </Fragment>

  <PageHero
    eyebrow={`— Salon ${salon.number}`}
    title={brandLabel(salon.nameLatin)}
  />

  {salon.heroImage && (
    <figure class="salon-atmos">
      <Picture
        class="salon-atmos__img"
        src={salon.heroImage.url}
        width={salon.heroImage.width}
        height={salon.heroImage.height}
        alt={`${salon.name}（${salon.nameLatin}）の店内`}
        loading="eager"
      />
    </figure>
  )}

  <section class="salon-detail">
    <div class="salon-detail__inner">
      <div class="salon-detail__lead">
        <p class="salon-detail__badge">{salon.badge}</p>
        <h2 class="salon-detail__name">{salon.name}</h2>
        <p class="salon-detail__city">{salon.city}</p>
        <p class="salon-detail__desc">{salon.description}</p>
        <nav class="salon-detail__links" aria-label="関連ページ">
          <a href="/effect-bleach">エフェクトブリーチ</a>
          <a href="/menu">メニュー・料金</a>
          <a href="/stylists">スタイリスト</a>
          <a href="/faq">よくある質問</a>
        </nav>
      </div>

      <dl class="salon-detail__specs">
        <div><dt>Address</dt><dd>{salon.address}</dd></div>
        {salon.access && <div><dt>Access</dt><dd>{salon.access}</dd></div>}
        <div><dt>Opened</dt><dd><em>est.</em> {salon.openedAt.replace(/-/g, ".")}</dd></div>
        {salon.renamedAt && (
          <div><dt>Renamed</dt><dd>{salon.renamedAt.replace(/-/g, ".")} (旧 {salon.formerName})</dd></div>
        )}
        <div><dt>Hours</dt><dd>{salon.hours}</dd></div>
        {salon.holidays && <div><dt>Holidays</dt><dd>{salon.holidays}</dd></div>}
        {salon.phone && <div><dt>Phone</dt><dd>{salon.phone}</dd></div>}
        {salon.hotPepperUrl && (
          <div>
            <dt>Booking</dt>
            <dd>
              <a href={salon.hotPepperUrl} target="_blank" rel="noopener">
                Hot Pepper Beauty →
              </a>
            </dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <section class="salon-area" aria-labelledby="salon-area-h">
    <div class="salon-area__inner">
      <h2 id="salon-area-h" class="salon-area__h">{area}の美容室 <span set:html={brandLabel(salon.name)} /></h2>
      <p class="salon-area__lead">
        <span set:html={brandLabel(salon.name)} />は、iLe が{area}で運営する美容室です。
        共同代表の2名が発案した<a href="/effect-bleach">エフェクトブリーチ</a>を軸に、ブリーチ・ハイトーン・バレイヤージュ・デザインカラーをご提案しています。
        {staffCount > 0 && `在籍スタッフは${staffCount}名です。`}
      </p>
    </div>
  </section>

  <section class="salon-faq" aria-labelledby="salon-faq-h">
    <div class="salon-area__inner">
      <h2 id="salon-faq-h" class="salon-area__h">よくある質問</h2>
      <dl class="salon-faq__list">
        {salonFaq.map((f, i) => (
          <div class="salon-faq__item">
            <dt><h3 class="salon-faq__q">{f.question}</h3></dt>
            <dd class="salon-faq__a">
              <p>{f.answer}</p>
              {salonFaqLinks[i] && (
                <a
                  href={salonFaqLinks[i]!.href}
                  {...(salonFaqLinks[i]!.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {salonFaqLinks[i]!.label} {salonFaqLinks[i]!.external ? "↗" : "→"}
                </a>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {salonStylists.length > 0 && (
    <section class="salon-stylists">
      <h2 class="salon-stylists__h">Stylists at <Fragment set:html={brandLabel(salon.nameLatin)} /></h2>
      <div class="salon-stylists__grid">
        {salonStylists.map((s, i) => (
          <StylistCard stylist={s} index={i} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .salon-atmos {
    margin: 0;
    width: 100%;
    aspect-ratio: 1600 / 680;
    max-height: 64vh;
    overflow: hidden;
    background: var(--color-ink);
    position: relative;
    z-index: 1;
  }
  .salon-atmos__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.02);
    display: block;
  }
  .salon-detail {
    padding: 110px 32px;
    background: var(--color-snow);
    position: relative;
    z-index: 1;
  }
  .salon-detail__inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 56px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .salon-detail__inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .salon-detail__badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 12px;
  }
  .salon-detail__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    margin: 0 0 12px;
  }
  .salon-detail__city {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 28px;
  }
  .salon-detail__desc {
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-fg);
    max-width: 480px;
  }
  .salon-detail__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin: 28px 0 0;
  }
  .salon-detail__links a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 15px;
    transition: color 0.15s, border-color 0.15s;
  }
  .salon-detail__links a:hover {
    color: var(--color-fg);
    border-color: var(--color-fg);
  }

  .salon-detail__specs {
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .salon-detail__specs > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
    margin: 0;
  }
  .salon-detail__specs dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0;
  }
  .salon-detail__specs dd {
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }
  .salon-detail__specs dd em {
    font-family: var(--font-display);
    font-style: italic;
  }
  .salon-detail__specs a {
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 1px;
  }

  .salon-area,
  .salon-faq {
    padding: 0 32px 80px;
    position: relative;
    z-index: 1;
  }
  .salon-area__inner {
    max-width: 860px;
    margin: 0 auto;
  }
  .salon-area__h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    margin: 0 0 20px;
  }
  .salon-area__lead {
    font-size: 15px;
    line-height: 2;
    margin: 0;
  }
  .salon-area__lead a,
  .salon-faq__a a {
    color: inherit;
    border-bottom: 1px solid currentColor;
  }
  .salon-faq__list {
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .salon-faq__item {
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .salon-faq__q {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .salon-faq__a {
    margin: 0;
    font-size: 14px;
    line-height: 1.9;
    color: var(--color-fg-muted);
  }
  .salon-faq__a p {
    margin: 0 0 6px;
  }
  .salon-faq__a a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .salon-stylists {
    padding: 110px 32px;
    background: var(--color-pearl);
    position: relative;
    z-index: 1;
  }
  .salon-stylists__h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: 1;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 56px;
  }
  .salon-stylists__grid {
    display: grid;
    gap: 32px 24px;
    grid-template-columns: repeat(2, 1fr);
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 700px) {
    .salon-stylists__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
