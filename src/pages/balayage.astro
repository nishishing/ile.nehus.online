const faq = [
  {
    question: "バレイヤージュとは何ですか？",
    answer:
      "毛束をほうきで掃くように塗り分けるハイライト技法です。根元を暗めに残して毛先に向かって明るくグラデーションさせるため、根元が伸びても境目が気になりにくく、メンテナンスしやすいのが特徴です。",
  },
  {
