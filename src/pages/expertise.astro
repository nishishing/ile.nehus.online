---
import BaseLayout from "~layouts/BaseLayout.astro";
import PageHero from "~components/PageHero.astro";
import SectionHead from "~components/SectionHead.astro";
import { breadcrumbSchema, authoredBooksSchema, jsonLd } from "~lib/schema";
import { site } from "~data/site";

const description =
  "iLe の専門性と権威。エフェクトブリーチを共同開発した酒井元樹（ケミカルの権威）と西村涼（バレイヤージュの第一人者・創業者）。実名の専門家が、ブリーチとデザインカラーの技術を体系化しています。";

// Human-readable label for an identity-profile URL.
function profileLabel(url: string): string {
  if (url.includes("instagram.com")) return "Instagram";
  if (url.includes("hotpepper.jp")) return "Hot Pepper Beauty";
  return new URL(url).hostname;
}

const pageSchemas = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Expertise", url: "/expertise" },
  ]),
  ...authoredBooksSchema(),
];
---

<BaseLayout title="Expertise" description={description}>
  <Fragment slot="head">
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={jsonLd(schema)} is:inline />
    ))}
  </Fragment>

  <PageHero eyebrow="— 専門性と権威" title="EXPERTISE" />

  <section class="ex-section ex-intro" aria-labelledby="intro-h">
    <div id="intro-h">
      <SectionHead small="— なぜ iLe なのか" title="技術を、実名の専門家が支える" />
    </div>
    <p class="ex-lead">
      iLe の強みは、特定の個人の技術と理論に裏打ちされています。独自ブリーチ技術
      「エフェクトブリーチ」を共同で開発した、二人の共同代表。
      ブリーチとデザインカラーの設計を体系化し、現場で磨き続けています。
    </p>
  </section>

  <section class="ex-section ex-people" aria-labelledby="people-h">
    <div id="people-h">
      <SectionHead small="— Co-Representatives" title="二人の専門家" />
    </div>
    <div class="people">
      {site.representatives.map((r) => (
        <article class="person">
          <header class="person__head">
            <p class="person__role">{r.title} / {r.titleEn}</p>
            <h3 class="person__name">
              {r.name}<span class="person__latin">{r.nameLatin}</span>
            </h3>
          </header>
          {r.bio && <p class="person__bio">{r.bio}</p>}
          {r.knowsAbout && (
            <ul class="chips" aria-label="専門分野">
              {r.knowsAbout.map((k) => <li class="chip">{k}</li>)}
            </ul>
          )}
          {r.authoredBook && (
            <p class="person__book">
              共著 — {site.book?.url ? (
                <a href={site.book.url} target="_blank" rel="noopener">
                  <cite>『{r.authoredBook}』</cite>
                </a>
              ) : (
                <cite>『{r.authoredBook}』</cite>
              )}
            </p>
          )}
          {r.sameAs?.length && (
            <p class="person__profiles">
              {r.sameAs.map((url) => (
                <a href={url} target="_blank" rel="noopener">{profileLabel(url)} ↗</a>
              ))}
            </p>
          )}
          {r.press?.length && (
            <ul class="person__press" aria-label={`${r.name}のメディア掲載・登壇`}>
              {r.press.map((p) => (
                <li>
                  <a href={p.url} target="_blank" rel="noopener">{p.label} ↗</a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="ex-section ex-book" aria-labelledby="book-h">
    <div id="book-h">
      <SectionHead small="— Publication" title="共著書" />
    </div>
    {site.book && (
      <div class="book">
        <p class="book__title">
          <cite>『{site.book.title}』</cite>
        </p>
        <p class="book__meta">
          酒井元樹・西村涼 共著／{site.book.publisher}刊（2022年4月8日発売）。
          複雑化したヘアカラーの施術履歴に対応するための、ブリーチとオンカラーの専門書。
        </p>
        <p class="book__links">
          {site.book.url && (
            <a href={site.book.url} target="_blank" rel="noopener">出版社の書籍ページ ↗</a>
          )}
          {site.book.sameAs?.map((url) => (
            <a href={url} target="_blank" rel="noopener">Amazon ↗</a>
          ))}
        </p>
      </div>
    )}
  </section>

  <section class="ex-section ex-media" aria-labelledby="media-h">
    <div id="media-h">
      <SectionHead small="— Media" title="メディア掲載" />
    </div>
    <ul class="media-list" aria-label="第三者メディアの掲載記事">
      {site.press?.map((p) => (
        <li>
          <a href={p.url} target="_blank" rel="noopener">{p.label} ↗</a>
        </li>
      ))}
    </ul>
  </section>

  {site.effectBleach && (
    <section class="ex-section ex-reach" aria-labelledby="reach-h">
      <div id="reach-h">
        <SectionHead small="— Reach" title="技術の広がり" />
      </div>
      <p class="ex-lead">
        エフェクトブリーチは{site.effectBleach.developedYear}年の開発以降、全国のサロン・美容師に導入され、
        {site.effectBleach.countries.join("・")}の{site.effectBleach.countries.length}か国に広がっています。
        iLe の技術を学ぶアンバサダーは{site.effectBleach.ambassadors}。開発元として、iLe は技術と理論を
        国内外に開いています。
      </p>
      <ul class="reach-facts" aria-label="エフェクトブリーチの実績">
        <li><span class="reach-facts__k">開発</span><span class="reach-facts__v">{site.effectBleach.developedYear}年</span></li>
        <li><span class="reach-facts__k">展開</span><span class="reach-facts__v">{site.effectBleach.countries.length}か国（{site.effectBleach.countries.join("・")}）</span></li>
        <li><span class="reach-facts__k">アンバサダー</span><span class="reach-facts__v">{site.effectBleach.ambassadors}</span></li>
      </ul>
    </section>
  )}

  {site.kamiCharisma && (
    <section class="ex-section ex-awards" aria-labelledby="awards-h">
      <div id="awards-h">
        <SectionHead small="— Awards" title="第三者評価 — KAMI CHARISMA" />
      </div>
      <p class="ex-lead">
        iLe の技術は第三者評価でも認められています。KAMI CHARISMA のヘアカラー部門で、
        共同代表の酒井 元樹が 2023〜2026アワードまで4年連続で受賞（最新は最上位の三つ色CCC）、
        西村 涼も同部門で受賞しています。サロン iLe. も 2023アワードから毎年受賞しています。
      </p>
      <div class="awards">
        <div class="awards__group">
          <h3 class="awards__h">個人受賞（ヘアカラー部門）</h3>
          {site.kamiCharisma.personal.map((p) => (
            <div class="awards__person">
              <p class="awards__name">{p.name}</p>
              <ul class="awards__years" aria-label={`${p.name}の受賞`}>
                {p.awards.map((a) => (
                  <li><span class="awards__year">{a.year}</span><span class="awards__grade">{a.grade}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="awards__group">
          <h3 class="awards__h">サロン受賞</h3>
          <ul class="awards__years" aria-label="サロン受賞">
            {site.kamiCharisma.salon.map((s) => (
              <li><span class="awards__year">{s.year}</span><span class="awards__grade">{s.detail}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <p class="awards__note">
        等級の呼称は KAMI CHARISMA 各年の正式名称に準じます（ヘアカラー部門は 2024アワードから
        「星」→「色」へ呼称変更）。個人受賞とサロン受賞は別の実績です。<br />
        主催: {site.kamiCharisma.organizer}（{site.kamiCharisma.organizerNote}）
        <a href={site.kamiCharisma.url} target="_blank" rel="noopener">公式サイト ↗</a>
      </p>
    </section>
  )}

  <section class="ex-section ex-tech" aria-labelledby="tech-h">
    <div id="tech-h">
      <SectionHead small="— Signature Technique" title="エフェクトブリーチ" />
    </div>
    <p class="ex-lead">
      ダメージ履歴を10段階で診断し、過酸化水素の濃度をミリ単位で調整する
      「パーソナル減力」。髪の芯を残しながら透明感のあるハイトーンを実現し、
      褪色していく過程の美しさまで設計します。黒染めやセルフカラーといった複雑な
      履歴を持つ髪にも対応する、iLe のシグネチャー技術です。
    </p>
    <p class="ex-links">
      <a href="/effect-bleach">エフェクトブリーチ →</a>
      <a href="/technology">3つの技術の柱 →</a>
      <a href="/story">ブランドストーリー →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .ex-section {
    padding: 110px 32px;
    position: relative;
    z-index: 1;
  }
  .ex-intro { background: var(--color-snow); }
  .ex-people { background: var(--color-pearl); }
  .ex-reach { background: var(--color-pearl); }
  .ex-awards { background: var(--color-snow); }
  .ex-tech { background: var(--color-ink); color: var(--color-white); }

  .awards {
    max-width: 900px;
    margin: 32px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .awards__h {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 16px;
  }
  .awards__person { margin-bottom: 20px; }
  .awards__name { font-size: 15px; margin: 0 0 8px; }
  .awards__years {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .awards__years li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    border-top: 1px solid var(--color-border);
    padding-top: 8px;
  }
  .awards__year {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    min-width: 96px;
  }
  .awards__grade { font-size: 14px; }
  .awards__note {
    max-width: 900px;
    margin: 28px auto 0;
    font-size: 12px;
    line-height: 1.9;
    color: var(--color-fg-muted);
  }
  .awards__note a { border-bottom: 1px solid currentColor; padding-bottom: 1px; margin-left: 4px; }
  @media (max-width: 640px) {
    .awards { grid-template-columns: 1fr; gap: 28px; }
  }

  .reach-facts {
    max-width: 760px;
    margin: 28px auto 0;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .reach-facts li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }
  .reach-facts__k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    min-width: 140px;
  }
  .reach-facts__v { font-size: 15px; }

  .ex-lead {
    max-width: 760px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 2;
  }

  .people {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .person {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
  }
  .person__role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 8px;
  }
  .person__name {
    font-size: 22px;
    margin: 0 0 16px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .person__latin {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted);
  }
  .person__bio {
    font-size: 14px;
    line-height: 1.9;
    margin: 0 0 18px;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 16px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 5px 12px;
    color: var(--color-fg-muted);
  }
  .person__book {
    font-size: 14px;
    margin: 0 0 14px;
  }
  .person__book cite { font-style: normal; }
  .person__book a { border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  .person__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .person__profiles a { border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  .person__press {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
    font-size: 13px;
    line-height: 1.7;
  }
  .person__press a { border-bottom: 1px solid var(--color-border); padding-bottom: 1px; }

  .ex-book { background: var(--color-snow); }
  .book { max-width: 760px; margin: 0 auto; }
  .book__title {
    font-size: 19px;
    margin: 0 0 14px;
  }
  .book__title cite { font-style: normal; }
  .book__meta {
    font-size: 14px;
    line-height: 1.9;
    margin: 0 0 18px;
    color: var(--color-fg-muted);
  }
  .book__links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .book__links a { border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  .ex-media { background: var(--color-pearl); }
  .media-list {
    list-style: none;
    max-width: 760px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 14px;
    font-size: 14px;
    line-height: 1.8;
  }
  .media-list a { border-bottom: 1px solid var(--color-border); padding-bottom: 1px; }

  .ex-links {
    max-width: 760px;
    margin: 28px auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .ex-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  @media (max-width: 720px) {
    .people { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
